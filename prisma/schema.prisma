generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String            @id @default(uuid())
  username      String            @unique
  password      String
  role          String            @default("INSTITUTION_MANAGER") // SUPER_ADMIN, ZONE_ADMIN, INSTITUTION_MANAGER, JUDGE
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  
  // Relations
  zoneId        String?
  zone          Zone?             @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  institutionId String?
  institution   MasterInstitution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  eventId       String?
  event         Event?            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([zoneId])
  @@index([institutionId])
}

model Zone {
  id           String              @id @default(uuid())
  name         String              @unique // e.g., MALAPPURAM EAST, PALAKKAD, KANNUR, KASSARAGOD, KOZHIKODE, KARNATAKA, THRISSUR, KOLLAM
  code         String              @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  institutions MasterInstitution[]
  users        User[]
  events       Event[]
}

model MasterInstitution {
  id            String      @id @default(uuid())
  code          String      @unique // e.g., SIG, TWI, AAW, TAC
  password      String      @default("123")
  affiliationNo String?
  name          String
  place         String?
  zoneId        String
  district      String?
  stream        String?     // e.g. FADHILA, FADHEELA, FADHILA FADHEELA
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  zone          Zone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  students      MasterStudent[]
  users         User[]
  candidates    Candidate[]
  teams         Team[]

  @@index([zoneId])
}

model MasterStudent {
  id            String            @id @default(uuid())
  uid           String            @unique // e.g. FL26CH12, FL26C0075
  name          String
  institutionId String
  district      String?
  phone         String?
  stream        String            // FADHILA or FADHEELA
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  institution   MasterInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  candidates    Candidate[]

  @@index([institutionId])
  @@index([uid])
}

model Event {
  id                 String          @id @default(uuid())
  name               String
  type               String          @default("ZONE") // ZONE or STATE
  zoneId             String?
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  parentId           String?
  parent             Event?          @relation("SubEvents", fields: [parentId], references: [id], onDelete: Cascade)
  subEvents          Event[]         @relation("SubEvents")
  categories         Category[]
  programs           Program[]
  teams              Team[]
  users              User[]
  pageVisits         PageVisit[]
  globalSetting      GlobalSetting?
  homepageSetting    HomepageSetting?
  contactMessages    ContactMessage[]
  zone               Zone?           @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([zoneId])
}

model Category {
  id                String       @id @default(uuid())
  name              String       // FADHILA, FADHEELA, GENERAL
  chestNumberOffset Int          @default(0)
  eventId           String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  candidates        Candidate[]
  event             Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  programs          Program[]

  @@index([eventId])
}

model Team {
  id            String            @id @default(uuid())
  name          String
  prefixCode    String            @unique
  eventId       String
  institutionId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  flagColor     String?           @default("#EC4899") // CSWC Pink theme default
  leaderName    String?
  candidates    Candidate[]
  results       Result[]
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  institution   MasterInstitution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([institutionId])
}

model Candidate {
  id            String              @id @default(uuid())
  name          String
  uid           String?             // Reference to MasterStudent UID e.g. FL26CH12
  chestNumber   String?             @unique
  categoryId    String
  teamId        String
  institutionId String?
  isApproved    Boolean             @default(true)
  isStateQualified Boolean          @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  
  team          Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  institution   MasterInstitution?  @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  masterStudent MasterStudent?      @relation(fields: [uid], references: [uid], onDelete: SetNull)
  programs      ProgramAssignment[]
  results       Result[]

  @@index([categoryId])
  @@index([teamId])
  @@index([uid])
}

model Program {
  id                    String              @id @default(uuid())
  programCode           String?
  name                  String
  type                  String              @default("INDIVIDUAL") // INDIVIDUAL or GROUP
  categoryId            String?
  eventId               String
  venue                 String?
  startTime             DateTime?
  duration              Int                 @default(10)
  stageType             String              @default("ON_STAGE") // ON_STAGE or OFF_STAGE
  candidateLimitPerTeam Int                 @default(1)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  event                 Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category              Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignments           ProgramAssignment[]
  results               Result[]

  @@index([eventId])
  @@index([categoryId])
}

model ProgramAssignment {
  id            String    @id @default(uuid())
  candidateId   String
  programId     String
  createdAt     DateTime  @default(now())
  scheduledTime DateTime?
  slotNumber    Int?
  program       Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, programId])
  @@index([programId])
}

model Result {
  id          String    @id @default(uuid())
  candidateId String?
  teamId      String?
  programId   String
  marks       Float
  rank        Int?
  grade       String?
  points      Float
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  program     Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  team        Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([candidateId, programId])
  @@unique([teamId, programId])
  @@index([programId])
  @@index([isPublished])
}

model GlobalSetting {
  id                            String    @id @default("default")
  festName                      String    @default("CSWC Hiya Fiesta 2026")
  festMoto                      String    @default("She Can. She Will.")
  festLogo                      String?
  updatedAt                     DateTime  @updatedAt
  eventId                       String?   @unique
  event                         Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model PageVisit {
  id        String   @id @default(uuid())
  eventId   String?
  path      String
  createdAt DateTime @default(now())
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model HomepageSetting {
  id                  String   @id @default(uuid())
  eventId             String   @unique
  heroTitle           String?  @default("CSWC Hiya Fiesta 2026")
  heroSubtitle        String?  @default("She Can. She Will.")
  heroBgUrl           String?
  aboutText           String?
  aboutTitle          String?  @default("Council of Samastha Women's Colleges")
  primaryColor        String?  @default("#EC4899") // CSWC Pink
  secondaryColor      String?  @default("#3B82F6") // Royal Blue
  bgColor             String?  @default("#FFFFFF")
  committeeMembers    Json?
  committeeTitle      String?  @default("Organizing Committee")
  galleryImages       Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}
